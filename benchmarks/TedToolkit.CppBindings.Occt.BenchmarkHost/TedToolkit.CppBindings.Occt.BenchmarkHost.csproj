<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\externals\TedToolkit\props\CodeAnalysis.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TedToolkit.CppBindings.Occt.BenchmarkHost</AssemblyName>
    <RootNamespace>TedToolkit.CppBindings.Occt.BenchmarkHost</RootNamespace>
    <NoWarn>$(NoWarn);ConsoleUse</NoWarn>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Analyzer Include="..\..\src\providers\occt\TedToolkit.CppBindings.Occt.SourceGenerators\bin\$(Configuration)\netstandard2.0\TedToolkit.RoslynHelper.dll" />
    <Analyzer Include="..\..\src\providers\occt\TedToolkit.CppBindings.Occt.SourceGenerators\bin\$(Configuration)\netstandard2.0\TedToolkit.CppBindings.Occt.SourceGenerators.dll" />
    <Analyzer Include="..\..\src\providers\occt\TedToolkit.CppBindings.Occt.SourceGenerators\bin\$(Configuration)\netstandard2.0\ZString.dll" />
    <Analyzer Include="..\..\src\providers\occt\TedToolkit.CppBindings.Occt.SourceGenerators\bin\$(Configuration)\netstandard2.0\System.Memory.dll" />
    <ProjectReference Include="..\..\src\providers\occt\TedToolkit.CppBindings.Occt.Generator\TedToolkit.CppBindings.Occt.Generator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="libclang.runtime.linux-x64" />
    <PackageReference Include="libClangSharp.runtime.linux-x64" />
    <PackageReference Include="Sourcy.DotNet">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
