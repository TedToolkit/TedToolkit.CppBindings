<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\..\externals\TedToolkit\props\CodeAnalysis.props" />
  <Import Project="..\..\..\..\externals\TedToolkit\props\NugetPackage.props" />

  <PropertyGroup>
    <AssemblyName>TedToolkit.CppBindings.Occt.Windows</AssemblyName>
    <RootNamespace>TedToolkit.CppBindings.Occt</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Title>TedToolkit OCCT Windows bindings</Title>
    <Description>Generated OCCT bindings for the pinned Windows x64 native artifact.</Description>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratedRoot>$(MSBuildProjectDirectory)\..\..\..\..\output\generated</GeneratedRoot>
    <VcpkgRoot Condition="'$(VcpkgRoot)' == ''">$(VCPKG_ROOT)</VcpkgRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TedToolkit.CppBindings.Occt.Runtime\TedToolkit.CppBindings.Occt.Runtime.csproj" />
    <ProjectReference Include="..\..\..\..\tests\TedToolkit.CppBindings.Occt.Console\TedToolkit.CppBindings.Occt.Console.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      OutputItemType="OcctGeneratorHost" />
    <None Include="$(GeneratedRoot)\native-build\$(Configuration)\ted_toolkit_occt.dll"
          Pack="true" PackagePath="runtimes\win-x64\native" />
    <None Include="$(GeneratedRoot)\native-dependencies\*.dll"
          Pack="true" PackagePath="runtimes\win-x64\native" />
  </ItemGroup>

  <Target Name="GenerateWindowsBindings"
          BeforeTargets="CoreCompile">
    <Error Condition="'$(VcpkgRoot)' == ''" Text="VCPKG_ROOT is required to generate TedToolkit.CppBindings.Occt.Windows." />
    <Error Condition="'@(OcctGeneratorHost)' == ''" Text="The OCCT generator host output was not resolved." />
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\..\..\Build\GenerateWindowsBindings.ps1&quot; -RepositoryRoot &quot;$(MSBuildProjectDirectory)\..\..\..\..&quot; -GeneratorHost &quot;@(OcctGeneratorHost)&quot; -GeneratedRoot &quot;$(GeneratedRoot)&quot; -VcpkgRoot &quot;$(VcpkgRoot)&quot; -Configuration &quot;$(Configuration)&quot;" />
  </Target>

  <Target Name="IncludeGeneratedWindowsBindings"
          BeforeTargets="CoreCompile"
          DependsOnTargets="GenerateWindowsBindings">
    <ItemGroup>
      <Compile Include="$(GeneratedRoot)\csharp\*.cs" />
    </ItemGroup>
  </Target>
</Project>
