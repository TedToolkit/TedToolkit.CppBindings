# Build the standalone kernel and SM_API from the pinned USD BRep source tree.
set(smlib_kernel_dir "${smlib_source}/source/SMLib")
set(smlib_api_dir "${smlib_source}/source/SM_API")
file(GLOB smlib_kernel_sources CONFIGURE_DEPENDS "${smlib_kernel_dir}/src/*.cpp")
file(GLOB smlib_api_sources CONFIGURE_DEPENDS "${smlib_api_dir}/src/*.cpp")
add_library(smlib_kernel OBJECT ${smlib_kernel_sources})
set_target_properties(smlib_kernel PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_compile_features(smlib_kernel PRIVATE cxx_std_17)
target_include_directories(smlib_kernel PRIVATE "${smlib_kernel_dir}/inc")
target_link_libraries(smlib_kernel PRIVATE Threads::Threads)
target_sources("${PROJECT_NAME}" PRIVATE ${smlib_api_sources})
target_link_libraries("${PROJECT_NAME}" PRIVATE smlib_kernel Threads::Threads)

if(MSVC)
    target_compile_definitions(smlib_kernel PRIVATE NOMINMAX NL_DEBUG_CODE)
    target_compile_definitions("${PROJECT_NAME}" PRIVATE NOMINMAX)
    target_compile_options(smlib_kernel PRIVATE /bigobj /utf-8 /MP4)
    target_compile_options("${PROJECT_NAME}" PRIVATE /bigobj /utf-8)
    target_precompile_headers(smlib_kernel PRIVATE "${smlib_kernel_dir}/inc/StdAfx.h")
endif()
