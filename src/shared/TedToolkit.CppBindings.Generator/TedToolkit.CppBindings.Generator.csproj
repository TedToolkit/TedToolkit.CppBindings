<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\..\externals\TedToolkit\props\CodeAnalysis.props" />
  <Import Project="..\..\..\externals\TedToolkit\props\NugetPackage.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Provider-neutral C++ binding generation stages, source publication, and Windows loading support.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClangSharp" />
    <PackageReference Include="libclang.runtime.win-x64" />
    <PackageReference Include="libClangSharp.runtime.win-x64" />
    <PackageReference Include="ModularPipelines" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="TedToolkit.RoslynHelper" />
    <PackageReference Include="TedToolkit.FileSystem" />
  </ItemGroup>
  <Target Name="ExcludePublicModuleHelpers" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'ModularPipelines.SourceGenerator'" />
    </ItemGroup>
  </Target>
</Project>
