<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\externals\TedToolkit\props\CodeAnalysis.props" />
  <Import Project="..\..\..\externals\TedToolkit\props\NugetPackage.props" />

  <PropertyGroup>
    <Title>Occt.Generator</Title>
    <Description>Generate the occt codes.</Description>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClangSharp" />
    <PackageReference Include="libclang.runtime.win-x64" />
    <PackageReference Include="libClangSharp.runtime.win-x64" />
    <PackageReference Include="ModularPipelines" />
    <None Include="..\..\tools\TedToolkit.Occt.Analyzer\bin\$(Configuration)\netstandard2.0\TedToolkit.Occt.Analyzer.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" PrivateAssets="All" />
    <None Include="..\..\tools\TedToolkit.Occt.Analyzer\bin\$(Configuration)\netstandard2.0\TedToolkit.RoslynHelper.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" PrivateAssets="All" />
    <None Include="..\..\tools\TedToolkit.Occt.Analyzer\bin\$(Configuration)\netstandard2.0\ZString.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" PrivateAssets="All" />
    <None Include="..\..\tools\TedToolkit.Occt.Analyzer\bin\$(Configuration)\netstandard2.0\System.Memory.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" PrivateAssets="All" />
    <PackageReference Include="TedToolkit.RoslynHelper" />
    <PackageReference Include="ZString" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\TedToolkit.Occt.Cpp\csharp_interop.h"
                      LogicalName="TedToolkit.Occt.Generator.Assets.cpp.csharp_interop.h"/>
    <EmbeddedResource Include="..\TedToolkit.Occt.Cpp\csharp_interop.cpp"
                      LogicalName="TedToolkit.Occt.Generator.Assets.cpp.csharp_interop.cpp"/>
    <EmbeddedResource Include="..\TedToolkit.Occt.Cpp\abi-v1\CMakeLists.txt"
                      LogicalName="TedToolkit.Occt.Generator.Assets.cpp.abi-v1.CMakeLists.txt"/>
    <EmbeddedResource Include="..\TedToolkit.Occt.Cpp\abi-v1\ted_toolkit_occt_v1.cpp"
                      LogicalName="TedToolkit.Occt.Generator.Assets.cpp.abi-v1.ted_toolkit_occt_v1.cpp"/>
    <EmbeddedResource Include="..\TedToolkit.Occt.Cpp\abi-v1\ted_toolkit_occt_v1_test.h"
                      LogicalName="TedToolkit.Occt.Generator.Assets.cpp.abi-v1.ted_toolkit_occt_v1_test.h"/>
  </ItemGroup>

</Project>
