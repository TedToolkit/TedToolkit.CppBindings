<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <UseSharedCompilation>false</UseSharedCompilation>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TedToolkit.CppBindings.Analyzers" PrivateAssets="all" />
    <PackageReference Include="TedToolkit.CppBindings.Runtime" Condition="'$(UseRuntime)' != 'false'" />
    <PackageReference Include="TedToolkit.CppBindings.Occt.Runtime" Condition="'$(UseOcct)' == 'true'" />
  </ItemGroup>
</Project>
