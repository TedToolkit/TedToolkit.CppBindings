<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <VcpkgRoot>$(VCPKG_ROOT)</VcpkgRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\output\generated\csharp\*.cs" Link="Generated\%(Filename)%(Extension)" />
    <ProjectReference Include="..\..\src\core\TedToolkit.Occt.Runtime\TedToolkit.Occt.Runtime.csproj" />
    <None Include="..\..\output\generated\native-build\Release\ted_toolkit_occt.dll"
          CopyToOutputDirectory="PreserveNewest">
      <Link>ted_toolkit_occt.dll</Link>
    </None>
    <None Include="$(VcpkgRoot)\installed\x64-windows\bin\*.dll"
          CopyToOutputDirectory="PreserveNewest"
          Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
