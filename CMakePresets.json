{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ted-occt-abi-v1-consumer",
      "displayName": "TedToolkit OCCT ABI v1 C consumer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/ted-occt-abi-v1-consumer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ted-occt-abi-v1-consumer",
      "configurePreset": "ted-occt-abi-v1-consumer",
      "jobs": 1
    }
  ],
  "testPresets": [
    {
      "name": "ted-occt-abi-v1-consumer",
      "configurePreset": "ted-occt-abi-v1-consumer",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
